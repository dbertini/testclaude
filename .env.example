# Configurazione applicazione e database
DB_URL=jdbc:postgresql://postgres:5432/libreria_db
DB_USER=libreria
DB_PASSWORD=<cambia_questa_cchiave_postgresql_password_hex_length_minimo_32_caratteri>
SPRING_PROFILES_ACTIVE=docker

# Autenticazione JWT
JWT_SECRET=<cambia_questa_cchiave_hex_length_minimo_32_caratteri_hexadecimal>
JWT_EXPIRES_IN=15m

# Porti di rete interna
PORT=8080

# Sicurezza
SECURITY_ENABLED=true
